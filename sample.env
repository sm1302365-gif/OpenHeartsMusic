# ==============================================================================
# sample.env - OpenHeartsMusic environment template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to git - it contains sensitive credentials.
#
# This project reads the variables used in OpenHeartsMusic/main/config.py.
# Update the values below before starting the bot.
# ==============================================================================

# ===== Telegram API =====
API_ID=
API_HASH=
BOT_TOKEN=

# Logger/chat used for bot notifications.
# Project config reads LOGGER_ID, not LOG_CHANNEL.
LOGGER_ID=
# LOG_CHANNEL=   # optional legacy alias; kept for older docs/scripts

# ===== Owner / developer info =====
OWNER_ID=
DEVELOPER_ID=
DEVELOPER_NAME=
DEVELOPER_USERNAME=

# ===== Mongo / database =====
MONGO_DB_URI=

# ===== Spotify metadata (optional) =====
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===== Bot limits =====
DURATION_LIMIT=300
QUEUE_LIMIT=30
PLAYLIST_LIMIT=20

# ===== Assistant/userbot sessions =====
# Required for music playback and helper assistant sessions.
# The app expects STRING_SESSION1, STRING_SESSION2, and/or STRING_SESSION3.
STRING_SESSION1=
STRING_SESSION2=
STRING_SESSION3=

# Legacy single-session variable kept only as a compatibility note:
# STRING_SESSION=

# ===== Core feature flags =====
AUTO_PLAY=False
WELCOME_ENABLED=True
AUTO_END=False
AUTO_LEAVE=False
THUMB_GEN=True
VIDEO_PLAY=True
BUTTON_BG_COLOR=green
VIDEO_MAX_HEIGHT=1080

# ===== YouTube cookies =====
# Optional: space-separated URLs from batbin.me, pastebin.com, paste.ee, rentry.co
COOKIE_URL=

# ===== UI / images =====
DEFAULT_THUMB=
PING_IMG=
START_IMG=
WELCOME_IMG=
SUPPORT_CHANNEL=https://t.me/ShreyanshMusicSupport
SUPPORT_CHAT=https://t.me/+jLpKEtUuhyNlODA1

# ===== Exclusions / moderation =====
# Comma-separated chat IDs that assistants should never leave.
EXCLUDED_CHATS=

# Space-separated usernames to exclude from admin mentions.
EXCLUDED_USERNAMES=

# ==============================================================================
# Example values:
# API_ID=12345678
# API_HASH=yefgeuyt9487328ty3p9hure
# BOT_TOKEN=123456:abcvgweuyg;uefh
# LOGGER_ID=-1001234567890
# MONGO_DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mydb
# STRING_SESSION1=your_hydrogram_session_string_here
# ==============================================================================
